generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Url {
  id          String    @id @default(cuid())
  originalUrl String
  shortCode   String    @unique
  userId      String?
  createdAt   DateTime  @default(now())
  expiresAt    DateTime?
  tags         String[]  @default([])
  passwordHash String?
  maxClicks    Int?
  clicks       Click[]

  @@index([userId])
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  prefix     String
  keyHash    String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}

model Click {
  id         String   @id @default(cuid())
  urlId      String
  clickedAt  DateTime @default(now())
  deviceType String   @default("unknown")
  browser    String   @default("unknown")
  os         String   @default("unknown")
  referrer   String   @default("direct")
  country    String   @default("unknown")
  /// Daily-rotating salted hash of IP + user agent, for unique visitor counts. Never reversible to an IP.
  visitorHash String?
  /// "qr" for QR scans, or the visitor's utm_source; null for plain clicks.
  source     String?
  url        Url      @relation(fields: [urlId], references: [id], onDelete: Cascade)

  @@index([urlId, clickedAt])
}
