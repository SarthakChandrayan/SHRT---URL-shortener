{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://shrt-url-shortener.onrender.com/api/:path*"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/analytics",
      "destination": "/index.html"
    },
    {
      "source": "/settings",
      "destination": "/index.html"
    },
    {
      "source": "/:shortCode([0-9A-Za-z_-]{1,64})",
      "destination": "https://shrt-url-shortener.onrender.com/:shortCode"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
