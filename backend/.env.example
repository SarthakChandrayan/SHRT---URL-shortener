# Pooled Neon connection used by Prisma Client at runtime.
# Copy the connection string that includes `-pooler` in the hostname.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Unpooled Neon connection used by Prisma CLI for migrations and introspection
# (schema.prisma `directUrl`). Copy the connection string without `-pooler`.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

PORT=3000

# Managed Better Auth (Neon Auth) — find these on the Auth tab of your branch
# in the Neon Console (Project -> Branch -> Auth -> Configuration).
NEON_AUTH_BASE_URL="https://ep-xxx.neonauth.REGION.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://ep-xxx.neonauth.REGION.aws.neon.tech/neondb/auth/.well-known/jwks.json"

# In-memory rate limits (per Node process). No Redis.
# Window is milliseconds; create cap applies to POST /api/urls per client IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_CREATE_MAX=30
# Public redirects: soft cap skips Click rows (still 302); hard cap returns 429.
RATE_LIMIT_REDIRECT_WINDOW_MS=60000
RATE_LIMIT_REDIRECT_MAX=60
RATE_LIMIT_REDIRECT_HARD_MAX=300
# Set to 1 if this API is behind a reverse proxy (so client IPs come from X-Forwarded-For).
RATE_LIMIT_TRUST_PROXY=0
