# Public API origin for production builds (no trailing slash).
# Leave unset in local development so Vite proxies `/api` to the backend.
# Example: https://api.example.com
VITE_API_ORIGIN=

# Public origin used when displaying shortened links (no trailing slash).
# Unset in local development — the app defaults to http://localhost:3000.
# Production: set this to the origin that serves redirects.
# Example: https://shrt.example.com
VITE_SHORT_ORIGIN=

# Neon Auth base URL for this branch (Project -> Branch -> Auth -> Configuration
# in the Neon Console). Required for sign in / sign up to work.
# Example: https://ep-xxx.neonauth.REGION.aws.neon.tech/neondb/auth
VITE_NEON_AUTH_URL=
