# Pooled Neon connection used by Prisma Client at runtime.
# Copy the connection string that includes `-pooler` in the hostname.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Unpooled Neon connection used by Prisma CLI for migrations and introspection
# (schema.prisma `directUrl`). Copy the connection string without `-pooler`.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

PORT=3000
